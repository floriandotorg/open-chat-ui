{
  "name": "open-chat-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "pb:setup": "bash scripts/setup-pocketbase.sh",
    "pb:serve": "./pocketbase/pocketbase serve --dir pb_data --http 127.0.0.1:8090",
    "pb:schema": "bun scripts/apply-pb-schema.ts",
    "pb:migrate-data": "bun scripts/migrate-to-pocketbase.ts",
    "user:add": "bun scripts/add-user.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "svelte": "^5.56.9",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@decodo/sdk-ts": "^2.2.0",
    "@mistralai/mistralai": "^2.6.3",
    "@tailwindcss/typography": "^0.5.20",
    "exa-js": "^2.18.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "openai": "^7.4.0",
    "pocketbase": "^0.27.3",
    "youtube-transcript": "^1.3.1"
  }
}
