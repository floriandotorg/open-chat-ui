{
  "name": "open-chat-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "start": "vite dev",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project ./src/service-worker/tsconfig.json --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "pb:setup": "bash scripts/setup-pocketbase.sh",
    "pb:serve": "./pocketbase/pocketbase serve --dir pb_data --http 127.0.0.1:8090",
    "pb:schema": "bun scripts/apply-pb-schema.ts",
    "pb:migrate-data": "bun scripts/migrate-to-pocketbase.ts",
    "size": "bun run build && bun scripts/report-bundle.ts",
    "user:add": "bun scripts/add-user.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "@sveltejs/adapter-bun": "^1.0.0",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@decodo/sdk-ts": "^2.7.0",
    "@mistralai/mistralai": "^3.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "exa-js": "^2.26.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "openai": "7.43.0",
    "pocketbase": "^0.28.1",
    "youtube-transcript": "^1.3.1"
  }
}
