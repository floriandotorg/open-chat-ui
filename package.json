{
  "name": "open-chat-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "pb:setup": "bash scripts/setup-pocketbase.sh",
    "pb:serve": "./pocketbase/pocketbase serve --dir pb_data --http 127.0.0.1:8090",
    "pb:schema": "bun scripts/apply-pb-schema.ts",
    "pb:migrate-data": "bun scripts/migrate-to-pocketbase.ts",
    "user:add": "bun scripts/add-user.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@vitest/browser-playwright": "^4.1.8",
    "playwright": "^1.60.0",
    "svelte": "^5.56.3",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@decodo/sdk-ts": "^2.1.2",
    "@mistralai/mistralai": "^2.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "exa-js": "^2.16.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "openai": "^6.46.0",
    "pocketbase": "^0.27.0",
    "youtube-transcript": "^1.3.1"
  }
}
