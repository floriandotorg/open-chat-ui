# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
# Browser-reachable PocketBase URL for client-side reads + realtime.
# In dev this is localhost; in prod reverse-proxy PB under your app origin.
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=""
POCKETBASE_ADMIN_PASSWORD=""

ORIGIN=""

# Encryption key for API keys at rest (use 32+ random characters)
ENCRYPTION_SECRET=""

# Bun server idle timeout in seconds (max 255). Must exceed the longest quiet
# stretch in an SSE stream — i.e. slow first-token, file uploads, tool rounds.
# The chat stream sends a keepalive every 15s; this is the upper safety bound.
IDLE_TIMEOUT=120
